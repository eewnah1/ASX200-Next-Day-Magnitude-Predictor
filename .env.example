# ASX200 Next-Day Magnitude Predictor configuration

# App
APP_NAME="ASX200 Next-Day Magnitude Predictor"
APP_ENV="development"
LOG_LEVEL="INFO"

# Timezone (Australia/Sydney used internally; display converted to AEST/AEDT)
TZ="Australia/Sydney"

# Database: SQLite for development; switch to Postgres by setting DATABASE_URL
DATABASE_URL="sqlite:///./asx200_predictor.db"
# DATABASE_URL="postgresql+psycopg://user:pass@localhost:5432/asx200"

# Data sources
NEWSAPI_API_KEY="your_newsapi_key"
MARKETAUX_API_KEY="your_marketaux_key"

# Optional paid / fallback API keys (leave empty to use free/fallback path)
FRED_API_KEY=""
ALPHAVANTAGE_API_KEY=""  # optional free-tier Alpha Vantage MCP enrichment

# Scheduler
SCHEDULE_DAILY="true"
DAILY_RUN_TIME="13:35"
US_CLOSE_UPDATE="true"
US_CLOSE_RUN_TIME="06:30"

# Scoring weights (relative allocations; values are normalised at runtime)
VOLATILITY_WEIGHT="0.20"
CATALYST_WEIGHT="0.14"
ALIGNMENT_WEIGHT="0.16"
SESSION_WEIGHT="0.07"
SPI_BASIS_WEIGHT="0.05"
FINANCIALS_VS_MATERIALS_WEIGHT="0.12"
HOUSING_CREDIT_WEIGHT="0.10"
CHINA_STEEL_PROPERTY_WEIGHT="0.08"
HEAVYWEIGHT_IDIO_WEIGHT="0.08"

# Technical indicators
RSI_WEIGHT="0.10"
ATH_DISTANCE_WEIGHT="0.10"
MOMENTUM_EXHAUSTION_WEIGHT="0.08"
BOLLINGER_WEIGHT="0.05"

# FastAPI / Uvicorn
API_HOST="0.0.0.0"
API_PORT="8000"

# Streamlit
UI_PORT="8501"
